def print_summary(df):
    print("\n" + "="*60)
    print("BATCH SUMMARY")
    print("="*60)
    print(f"Total straws measured   :  {len(df)}")
    if len(df) > 0:
        print(f"Average length (mm)     :  {df['Length_mm'].mean():.2f}")
        print(f"Min / Max (mm)          :  "
              f"{df['Length_mm'].min():.2f} / {df['Length_mm'].max():.2f}")
        print(f"Straight / Curved       :  "
              f"{(df['Shape']=='Straight').sum()} / {(df['Shape']=='Curved').sum()}")
        print(f"Overlap detected        :  {df['Overlap_Detected'].sum()}")
        if "Reconstructed" in df.columns:
            print(f"Reconstructed (crossed) :  {df['Reconstructed'].sum()}")
        print(f"HIGH confidence         :  {(df['Confidence']=='HIGH').sum()}")
        print(f"MEDIUM confidence       :  {(df['Confidence']=='MEDIUM').sum()}")
        print(f"LOW confidence          :  {(df['Confidence']=='LOW').sum()}")
        print(f"RECONSTRUCTED           :  {(df['Confidence']=='RECONSTRUCTED').sum()}")
        if "Pixel_to_mm" in df.columns:
            unique_ratios = df["Pixel_to_mm"].unique()
            if len(unique_ratios) == 1:
                print(f"Calibration (mm/px)     :  {unique_ratios[0]:.6f}  [single]")
            else:
                print(f"Calibration (mm/px)     :  "
                      f"min={unique_ratios.min():.6f}  "
                      f"max={unique_ratios.max():.6f}  "
                      f"[{len(unique_ratios)} unique values]")
        if "Detection_Source" in df.columns:
            print(f"YOLO / HSV detections   :  "
                  f"{(df['Detection_Source']=='yolo').sum()} / "
                  f"{(df['Detection_Source']=='hsv').sum()}")
    print("="*60 + "\n")

# ============================================================
# EXCEL SAVE WITH EMBEDDED OVERLAY IMAGES
# ============================================================

def save_excel_with_images(df, overlay_paths, filename):
    """
    Saves measurement data to Excel with:
    - Sheet 1 (Results): full data table with professional formatting
    - Sheet 2 (Overlays): each processed image embedded, one per row,
      labeled with the source image filename and straw count
    """
    wb = Workbook()

    # ---- Sheet 1: Results data ----
    ws_data = wb.active
    ws_data.title = "Results"

    header_fill   = PatternFill("solid", fgColor="2E4057")
    header_font   = Font(bold=True, color="FFFFFF", name="Arial", size=11)
    row_font      = Font(name="Arial", size=10)
    alt_fill      = PatternFill("solid", fgColor="EAF4FB")
    border_side   = Side(style="thin", color="CCCCCC")
    cell_border   = Border(
        left=border_side, right=border_side,
        top=border_side,  bottom=border_side
    )

    col_order = [
        "Image", "Straw_ID", "Length_mm", "Shape",
        "Overlap_Detected", "Reconstructed", "Confidence",
        "Detection_Source", "YOLO_Conf", "Endpoint_Method",
        "Skeleton_Pixels", "Path_Euclidean_Ratio",
        "Pixel_to_mm_Used", "Pixel_to_mm"
    ]
    cols = [c for c in col_order if c in df.columns]

    # Write header
    for col_idx, col_name in enumerate(cols, start=1):
        cell              = ws_data.cell(row=1, column=col_idx, value=col_name)
        cell.font         = header_font
        cell.fill         = header_fill
        cell.alignment    = Alignment(horizontal="center", vertical="center")
        cell.border       = cell_border

    # Write data rows
    for row_idx, (_, row) in enumerate(df[cols].iterrows(), start=2):
        fill = alt_fill if row_idx % 2 == 0 else None
        for col_idx, col_name in enumerate(cols, start=1):
            val  = row[col_name]
            cell = ws_data.cell(row=row_idx, column=col_idx, value=val)
            cell.font      = row_font
            cell.border    = cell_border
            cell.alignment = Alignment(horizontal="center", vertical="center")
            if fill:
                cell.fill = fill

    # Auto-size columns
    for col_idx, col_name in enumerate(cols, start=1):
        max_len = max(len(str(col_name)),
                      max((len(str(df[col_name].iloc[i]))
                           for i in range(len(df))), default=0))
        ws_data.column_dimensions[get_column_letter(col_idx)].width = min(max_len + 4, 30)

    ws_data.row_dimensions[1].height = 20
    ws_data.freeze_panes = "A2"

    # ---- Sheet 2: Overlay images ----
    ws_imgs = wb.create_sheet(title="Overlays")
    ws_imgs.column_dimensions["A"].width = 18
    ws_imgs.column_dimensions["B"].width = 100

    ws_imgs["A1"] = "Image"
    ws_imgs["B1"] = "Overlay"
    ws_imgs["A1"].font = header_font
    ws_imgs["B1"].font = header_font
    ws_imgs["A1"].fill = header_fill
    ws_imgs["B1"].fill = header_fill
    ws_imgs["A1"].alignment = Alignment(horizontal="center", vertical="center")
    ws_imgs["B1"].alignment = Alignment(horizontal="center", vertical="center")

    img_row = 2
    IMG_HEIGHT_PX  = 300   # display height in Excel (pixels)
    ROW_HEIGHT_PT  = 225   # approx row height in points to fit image

    for img_path, fname, straw_count in overlay_paths:
        if not os.path.exists(img_path):
            log.warning(f"Overlay not found for embedding: {img_path}")
            continue

        label = f"{fname}\n{straw_count} straw(s)"
        cell  = ws_imgs.cell(row=img_row, column=1, value=label)
        cell.font      = Font(name="Arial", size=10, bold=True)
        cell.alignment = Alignment(horizontal="center", vertical="center",
                                   wrap_text=True)

        try:
            xl_img = XLImage(img_path)
            # Scale to fixed display height, preserve aspect ratio
            orig_h = xl_img.height
            orig_w = xl_img.width
            scale  = IMG_HEIGHT_PX / orig_h if orig_h > 0 else 1.0
            xl_img.height = IMG_HEIGHT_PX
            xl_img.width  = int(orig_w * scale)

            # Anchor image in column B of this row
            col_letter    = get_column_letter(2)
            anchor_cell   = f"{col_letter}{img_row}"
            xl_img.anchor = anchor_cell
            ws_imgs.add_image(xl_img)

            ws_imgs.row_dimensions[img_row].height = ROW_HEIGHT_PT
            log.info(f"  Embedded overlay: {img_path}")
        except Exception as e:
            log.warning(f"  Could not embed image {img_path}: {e}")
            ws_imgs.cell(row=img_row, column=2,
                         value=f"[Image could not be embedded: {e}]")

        img_row += 1

    # Save
    base_path = os.path.abspath(filename)
    try:
        wb.save(base_path)
        return base_path
    except PermissionError:
        ts        = time.strftime("%Y%m%d_%H%M%S")
        name, ext = os.path.splitext(base_path)
        new_path  = f"{name}_{ts}{ext}"
        log.warning(f"'{base_path}' locked -- saving to '{new_path}'")
        print(f"\n  WARNING: File open in Excel. Saving to {os.path.basename(new_path)}\n")
        wb.save(new_path)
        return new_path

