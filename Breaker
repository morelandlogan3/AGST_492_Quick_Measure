# ============================================================
# CALIBRATION -- QUARTER DETECTION
# ============================================================

def calibrate_from_quarter(image, yolo_model):
    if yolo_model is None:
        return None, "no YOLO model loaded"

    h_img, w_img       = image.shape[:2]
    results            = yolo_model(image, conf=YOLO_CONF, verbose=False)[0]
    names              = yolo_model.names
    quarter_detections = []

    for idx, box in enumerate(results.boxes):
        cls_id   = int(box.cls[0])
        cls_name = names.get(cls_id, "").lower().strip()
        if cls_name != QUARTER_CLASS_NAME.lower().strip():
            continue

        conf            = float(box.conf[0])
        x1, y1, x2, y2 = map(int, box.xyxy[0].tolist())
        pixel_diameter  = None
        method          = None

        # Method 1: ellipse on segmentation mask
        if results.masks is not None and idx < len(results.masks.data):
            mask_raw = results.masks.data[idx].cpu().numpy()
            mask_u8  = (mask_raw * 255).astype(np.uint8)
            mask_u8  = cv2.resize(mask_u8, (w_img, h_img),
                                  interpolation=cv2.INTER_NEAREST)
            _, mask_bin = cv2.threshold(mask_u8, 127, 255, cv2.THRESH_BINARY)
            contours, _ = cv2.findContours(mask_bin, cv2.RETR_EXTERNAL,
                                           cv2.CHAIN_APPROX_SIMPLE)
            if contours:
                largest = max(contours, key=cv2.contourArea)
                if len(largest) >= 5:
                    try:
                        ellipse        = cv2.fitEllipse(largest)
                        major_axis     = max(ellipse[1])
                        minor_axis     = min(ellipse[1])
                        pixel_diameter = (major_axis + minor_axis) / 2.0
                        method         = "ellipse"
                        log.info(f"  Quarter ellipse: major={major_axis:.1f}px "
                                 f"minor={minor_axis:.1f}px avg={pixel_diameter:.1f}px")
                        if not _SUPPRESS_POPUPS and DEBUG_MODE:
                            dbg = image.copy()
                            cv2.ellipse(dbg, ellipse, (0, 255, 0), 2)
                            cv2.putText(dbg,
                                        f"Quarter ellipse d={pixel_diameter:.1f}px",
                                        (x1, max(y1 - 10, 20)),
                                        cv2.FONT_HERSHEY_SIMPLEX, 0.55,
                                        (0, 255, 0), 2, cv2.LINE_AA)
                            debug_step("Quarter Ellipse Fit", dbg, wait=800)
                    except cv2.error as e:
                        log.warning(f"  fitEllipse failed: {e}")

        # Method 2: bounding box fallback
        if pixel_diameter is None:
            bw             = x2 - x1
            bh             = y2 - y1
            pixel_diameter = (bw + bh) / 2.0
            method         = "bbox_fallback"
            log.info(f"  Quarter bbox: w={bw}px h={bh}px avg={pixel_diameter:.1f}px")
            if not _SUPPRESS_POPUPS and DEBUG_MODE:
                dbg = image.copy()
                cv2.rectangle(dbg, (x1, y1), (x2, y2), (0, 200, 255), 2)
                cv2.putText(dbg,
                            f"Quarter bbox d={pixel_diameter:.1f}px",
                            (x1, max(y1 - 10, 20)),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.55,
                            (0, 200, 255), 2, cv2.LINE_AA)
                debug_step("Quarter BBox Fallback", dbg, wait=800)

        if pixel_diameter and pixel_diameter > 0:
            quarter_detections.append({
                "pixel_diameter": pixel_diameter,
                "method":         method,
                "conf":           conf,
            })

    if not quarter_detections:
        return None, "no quarter detected in image"

    best  = max(quarter_detections, key=lambda d: d["conf"])
    px2mm = QUARTER_DIAMETER_MM / best["pixel_diameter"]
    log.info(f"  Calibration: {QUARTER_DIAMETER_MM}mm / "
             f"{best['pixel_diameter']:.2f}px = {px2mm:.5f} mm/px "
             f"[method={best['method']} conf={best['conf']:.2f}]")
    return px2mm, best["method"]


def get_calibration_for_image(image, image_path, yolo_model, cached_ratio):
    fname = os.path.basename(image_path)

    if CALIBRATION_MODE == "manual":
        ratio = get_calibration_manual()
        return ratio, cached_ratio

    if not CALIBRATION_PER_IMAGE and cached_ratio is not None:
        log.info(f"  [{fname}] Reusing cached calibration: {cached_ratio:.5f} mm/px")
        return cached_ratio, cached_ratio

    ratio, info = calibrate_from_quarter(image, yolo_model)

    if ratio is None:
        if cached_ratio is not None and not CALIBRATION_PER_IMAGE:
            log.warning(f"  [{fname}] No quarter found -- reusing cached ratio.")
            return cached_ratio, cached_ratio
        log.warning(f"  [{fname}] SKIPPED -- no quarter detected and no cached calibration.")
        print(f"\n  WARNING: '{fname}' skipped -- no quarter found for calibration.\n"
              f"     (Set CALIBRATION_MODE='manual' or include a quarter in every image)\n")
        return None, cached_ratio

    log.info(f"  [{fname}] Auto-calibration OK: {ratio:.5f} mm/px [{info}]")
    return ratio, ratio


def get_calibration_manual():
    print("\n--- CALIBRATION ---")
    print(f"Default pixel-to-mm ratio: {PIXEL_TO_MM}")
    user_input = input("Enter mm per pixel or press Enter for default: ").strip()
    if user_input:
        try:
            cal = float(user_input)
            log.info(f"Calibration set: {cal} mm/pixel")
            return cal
        except ValueError:
            log.warning("Invalid input. Using default.")
    log.info(f"Using default: {PIXEL_TO_MM} mm/pixel")
    return PIXEL_TO_MM

