def load_yolo_model(model_path):
    try:
        from ultralytics import YOLO
        if not os.path.exists(model_path):
            log.warning(f"YOLO model not found at '{model_path}'. Falling back to HSV.")
            return None
        model = YOLO(model_path)
        log.info(f"YOLO model loaded: {model_path}")
        return model
    except ImportError:
        log.warning("ultralytics not installed (pip install ultralytics). Falling back to HSV.")
        return None
    except Exception as e:
        log.warning(f"YOLO load failed: {e}. Falling back to HSV.")
        return None

