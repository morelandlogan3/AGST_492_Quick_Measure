def print_summary(df):
    print("\n" + "="*60)
    print("BATCH SUMMARY")
    print("="*60)
    print(f"Total straw measured    :  {len(df)}")
    if len(df) > 0:
        print(f"Average length (mm)     :  {df['Length_mm'].mean():.2f}")
        print(f"Min / Max (mm)          :  {df['Length_mm'].min():.2f} / {df['Length_mm'].max():.2f}")
        print(f"Straight / Curved       :  {(df['Shape']=='Straight').sum()} / {(df['Shape']=='Curved').sum()}")
        print(f"Overlap detected        :  {df['Overlap_Detected'].sum()}")
        if "Reconstructed" in df.columns:
            print(f"Reconstructed (crossed) :  {df['Reconstructed'].sum()}")
        print(f"HIGH confidence         :  {(df['Confidence']=='HIGH').sum()}")
        print(f"MEDIUM confidence       :  {(df['Confidence']=='MEDIUM').sum()}")
        print(f"LOW confidence          :  {(df['Confidence']=='LOW').sum()}")
        print(f"RECONSTRUCTED           :  {(df['Confidence']=='RECONSTRUCTED').sum()}")
        if "Detection_Source" in df.columns:
            print(f"YOLO / HSV detections   :  "
                  f"{(df['Detection_Source']=='yolo').sum()} / "
                  f"{(df['Detection_Source']=='hsv').sum()}")
    print("="*60 + "\n")

