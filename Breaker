    log.info(f"Angle tolerance: {ANGLE_TOLERANCE_DEG}°  |  "
             f"Cluster radius: {CLUSTER_RADIUS_PX}px")

    files = select_files()
    if not files:
        log.error("No files selected.")
        sys.exit(0)

    pixel_to_mm = get_calibration()

    mode       = DETECTION_MODE.lower()
    yolo_model = None
    hsv_lower  = hsv_upper = None

    if mode == "yolo":
        yolo_model = load_yolo_model(YOLO_MODEL_PATH)
        if yolo_model is None:
            mode = "hsv"

    if mode == "hsv":
        hsv_lower, hsv_upper = get_hsv(files[0])

    all_results = []
    for idx, f in enumerate(files):
        log.info(f"\nImage {idx+1}/{len(files)}: {f}")
        res, overlay = process_image(
            f, pixel_to_mm, mode,
            hsv_lower=hsv_lower, hsv_upper=hsv_upper,
            yolo_model=yolo_model
        )
        all_results.extend(res)

        if overlay is not None:
            base    = os.path.splitext(os.path.basename(f))[0]
            out_dir = os.path.dirname(os.path.abspath(f))
            out_img = os.path.join(out_dir, f"overlay_{base}.jpg")
            cv2.imwrite(out_img, overlay)
            log.info(f"Overlay saved: {out_img}")
            cv2.imshow(f"Result [{idx+1}/{len(files)}]: {os.path.basename(f)}", overlay)
            cv2.waitKey(800)

    cv2.destroyAllWindows()

    df = pd.DataFrame(all_results)
    if len(df) > 0:
        col_order = [
            "Image", "Straw_ID", "Length_mm", "Shape",
            "Overlap_Detected", "Reconstructed", "Confidence",
            "Detection_Source", "YOLO_Conf", "Endpoint_Method",
            "Skeleton_Pixels", "Path_Euclidean_Ratio", "Pixel_to_mm_Used"
        ]
        df = df[[c for c in col_order if c in df.columns]]
        xlsx = safe_save_excel(df, "straw_results.xlsx")
        csv  = os.path.abspath("straw_results.csv")
        df.to_csv(csv, index=False)
        print_summary(df)
        print(f"Results saved to:\n  Excel : {xlsx}\n  CSV   : {csv}")
    else:
        log.warning("No straw detected.")
        print("\nNo straw detected. Check HSV settings or YOLO model.")

    log.info(f"=== Done in {time.time()-t0:.2f}s ===")
    print(f"\nDebug log: {os.path.abspath(LOG_FILE)}")
